# Copy to .env.prod; do not commit real credentials.
# Use a published, scanned commit SHA for TAG.
# The API reports this same TAG as version in /api/health.
TAG=
# Base64 encoding at least 32 cryptographically random bytes. Use a production-only key.
APP_JWT_SECRET=
APP_JWT_TTL_SECONDS=900
# Exact public portal origin, e.g. https://your-domain.example (no trailing slash).
APP_CORS_ALLOWED_ORIGINS=
MYSQL_DATABASE=db_unab
MYSQL_USER=veterinary
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Different passwords, minimum 12 characters and maximum 72 UTF-8 bytes.
APP_INITIAL_ADMIN_PASSWORD=
APP_INITIAL_STAFF_PASSWORD=
