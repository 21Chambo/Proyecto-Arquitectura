# ============================================================
# Sistema Veterinario — Variables de Entorno
# Copia este archivo como .env y ajusta los valores
#   cp .env.example .env
# ============================================================

# ── Base de Datos MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=db_unab
MYSQL_USER=veterinary
MYSQL_PASSWORD=
MYSQL_PORT=13306

# ── Backend API (Spring Boot) ────────────────────────────────
API_PORT=9090

# Acceso inicial: usuarios admin y staff. Define claves distintas (12 caracteres
# como minimo, 72 bytes UTF-8 como maximo). Nunca publiques el archivo .env.
# Solo inicializan cuentas que todavia conservan el hash original de V0002.
# Cambiar estas variables despues NO restablece una contrasena personalizada.
APP_INITIAL_ADMIN_PASSWORD=
APP_INITIAL_STAFF_PASSWORD=

# ── Frontend Portal (Angular/Nginx) ─────────────────────────
PORTAL_PORT=3000

# GHCR tag for compose.prod.yml
TAG=
