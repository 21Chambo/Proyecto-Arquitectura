# ── Base de Datos MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=db_unab
MYSQL_USER=veterinary
MYSQL_PASSWORD=veterinary
MYSQL_PORT=13306

# ── Backend API (Spring Boot) ────────────────────────────────
API_PORT=9090

# ── Frontend Portal (Angular/Nginx) ─────────────────────────
PORTAL_PORT=3000
